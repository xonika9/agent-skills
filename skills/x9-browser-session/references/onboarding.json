{
  "version": 1,
  "requirements": [
    {
      "id": "native-browser-control",
      "group": "browser-control-route",
      "kind": "runtime-feature",
      "level": "required",
      "needed_for": "Using native browser control.",
      "check": {"type": "runtime-feature", "feature_id": "browser-control"},
      "guidance_id": "enable-runtime-feature"
    },
    {
      "id": "browse-command",
      "kind": "command",
      "level": "required",
      "needed_for": "Controlling the logged-in Edge profile through Browse. Install it with step 3 of the browser skill setup guide.",
      "check": {"type": "command-present", "command": "browse"},
      "guidance_id": "install-command"
    },
    {
      "id": "chrome-devtools-mcp",
      "group": "browser-control-route",
      "kind": "mcp",
      "level": "required",
      "needed_for": "DevTools work and the fallback browser route.",
      "check": {"type": "runtime-component", "component_id": "chrome-devtools"},
      "guidance_id": "configure-mcp"
    },
    {
      "id": "browse-extension-paired",
      "kind": "user-action",
      "level": "optional",
      "needed_for": "Adding the Browse extension to the automation profile with one store click, then pairing it.",
      "check": {"type": "manual"},
      "guidance_id": "complete-user-action"
    },
    {
      "id": "python3-edge-gate",
      "kind": "command",
      "level": "optional",
      "needed_for": "Running the Linux chrome-devtools MCP gate. Other routes do not need Python.",
      "check": {"type": "command-present", "command": "python3"},
      "guidance_id": "install-command"
    },
    {
      "id": "authenticated-browser-profile",
      "kind": "user-action",
      "level": "optional",
      "needed_for": "Using authenticated browser sessions.",
      "check": {"type": "manual"},
      "guidance_id": "complete-user-action"
    }
  ]
}
