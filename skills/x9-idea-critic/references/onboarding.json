      "guidance_id": "install-command"
    },
    {
      "id": "codex-native-subagents",
      "runtimes": ["codex"],
      "kind": "runtime-feature",
      "level": "required",
      "group": "codex-provider-route",
      "needed_for": "Running GPT critics.",
