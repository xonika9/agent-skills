      "guidance_id": "install-command"
    },
    {
      "id": "claude-gpt-delegation",
      "runtimes": ["claude"],
      "kind": "skill",
      "level": "required",
      "group": "claude-provider-route",
      "needed_for": "Running GPT critics.",
      "check": {"type": "skill-present", "target_skill": "x9-codex-delegation"},
      "guidance_id": "install-skill"
    },
    {
      "id": "opencode-claude-cli",
      "runtimes": ["opencode"],
      "kind": "command",
      "level": "required",
      "group": "opencode-provider-route",
      "needed_for": "Running Claude critics through Claude CLI.",
      "check": {"type": "command-present", "command": "claude"},
      "guidance_id": "install-command"
    },
    {
      "id": "opencode-native-subagents",
      "runtimes": ["opencode"],
      "kind": "runtime-feature",
      "level": "required",
      "group": "opencode-provider-route",
