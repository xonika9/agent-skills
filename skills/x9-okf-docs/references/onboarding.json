      "check": {"type": "command-version", "command": "python3", "min_version": "3.9"},
      "guidance_id": "install-command"
    },
    {
      "id": "ruby-runtime",
      "kind": "command",
      "level": "required",
      "needed_for": "Reading YAML frontmatter strictly.",
      "check": {"type": "command-present", "command": "ruby"},
      "guidance_id": "install-command"
    },
    {
      "id": "ruby-psych-module",
      "kind": "user-action",
      "level": "required",
      "needed_for": "Confirming that Ruby Psych loads, with the skill's dependency check.",
      "check": {"type": "manual"},
      "guidance_id": "complete-user-action"
    },
    {
      "id": "context-files-generator",
      "kind": "skill",
      "level": "optional",
      "needed_for": "Replacing stale OKF sections in repository instructions.",
      "check": {"type": "skill-present", "target_skill": "x9-context-files-generator"},
      "guidance_id": "install-skill"
