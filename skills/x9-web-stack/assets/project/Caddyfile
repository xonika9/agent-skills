{$SITE_ADDRESS} {
	encode

	handle /api/* {
		reverse_proxy api:3000
	}

	handle /health {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		# API responses get their headers from the API; the documents get them here.
		header {
			Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'"
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
		}
		# index.html must never be cached, or clients keep requesting
		# chunks that no longer exist after a release.
		@mutable not path /assets/*
		header @mutable Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
